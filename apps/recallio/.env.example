# Supabase — the same project the phone app uses, so accounts are shared.
NEXT_PUBLIC_SUPABASE_URL=https://rhfxoxsntsscbfjsyjsd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Razorpay key id only. The secret lives in the Supabase edge function and
# must never reach this app or the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...

# Hostnames. Matching is exact, so a lookalike domain cannot render the
# admin view.
NEXT_PUBLIC_USER_HOST=user.recallio.calecutech.com
NEXT_PUBLIC_ADMIN_HOST=superuser.recallio.calecutech.com

# Optional: a course hosted in its own schema (one deployment per schema).
# Geological Assistant (USS project):
#   NEXT_PUBLIC_SUPABASE_URL=https://vspbbwpehvenmxddgbhm.supabase.co
#   NEXT_PUBLIC_SUPABASE_SCHEMA=geological_assistant
#   NEXT_PUBLIC_PAY_FUNCTION=ga-razorpay-create-order
#   NEXT_PUBLIC_FREE_TIER=off
# Unset = the Recallio engine in public with razorpay-create-order.
