# Copy to .env.local and fill in. Nothing here has a working default —
# a missing value stops the app at startup rather than running insecurely.

# Postgres. Neon in production; any Postgres 14+ locally.
# The role in this URL should NOT be a superuser: see docs and
# drizzle/0002_app_role.sql. Requests drop to `calecute_app` regardless.
DATABASE_URL=postgresql://user:password@host/calecute

# Google OAuth. Web client (authorization-code flow) and, if different,
# the Android client. Both are accepted as ID-token audiences.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=

# Signing and encryption. Generate each with: openssl rand -base64 32
JWT_SECRET=
PII_ENCRYPTION_KEY=
PII_FINGERPRINT_KEY=

JWT_ISSUER=https://api.calecutech.com
JWT_AUDIENCE=calecute-agents
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Browsers allowed to call the API. Comma separated, exact origins.
CORS_ALLOWED_ORIGINS=https://calecutech.com

# Used to build agent referral links.
PUBLIC_WEB_ORIGIN=https://calecutech.com

NODE_ENV=development
