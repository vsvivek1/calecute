# Supabase. The same project the Flutter app uses, so a parent sees the same
# thing on the web and on the phone. Expose the `pta` schema under
# Settings -> API -> Exposed schemas.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Demo mode. Leave the Supabase variables unset and set this to 1 to run on a
# built-in database with a sample school, and pick parent / teacher / office
# from the sign-in page. Every cold start resets the data. Never set it on the
# real deployment.
PTA_DEMO=1
