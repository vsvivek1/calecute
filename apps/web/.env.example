# Local development. The frontend holds NO database credential, by design —
# the only backend it knows about is the API.
API_BASE_URL=https://api.calecutech.com/api/v1
NEXT_PUBLIC_API_BASE_URL=https://api.calecutech.com/api/v1
NEXT_PUBLIC_SITE_ORIGIN=https://calecutech.com

# Public client id only. The secret lives in the API, never here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# History Clock payments (Stripe Checkout, USD, US customers).
# Use a TEST key (sk_test_…) until launch. Server only, never NEXT_PUBLIC_.
# With no key set, /history-clock/support shows "Payments open soon".
STRIPE_SECRET_KEY=
# Optional: a Stripe Price id. When unset, checkout uses HISTORY_CLOCK_PRICE_CENTS.
STRIPE_PRICE_ID=
HISTORY_CLOCK_PRICE_CENTS=499
