NEXT_PUBLIC_API_BASE_URL=https://api.calecutech.com/api/v1
NEXT_PUBLIC_SITE_ORIGIN=https://calecutech.com

# Public client id only. The secret lives in the API, never here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
