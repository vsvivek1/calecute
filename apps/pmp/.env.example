# Stripe — use TEST keys (sk_test_…) until launch. Nothing here is public.
STRIPE_SECRET_KEY=sk_test_replace_me
# Optional: a Stripe Price for the $100 one-time product. When unset the
# checkout builds the line item inline at PRICE_CENTS.
STRIPE_PRICE_ID=
PRICE_CENTS=10000

# Signs licence keys. `openssl rand -base64 32`. Rotating it invalidates
# every key already issued, so set it once.
LICENSE_SECRET=replace_me

# Canonical origin of this deployment, used for Stripe redirect URLs.
PUBLIC_SITE_ORIGIN=http://localhost:3200

# Android build only: where the app reaches the licence and question API.
NEXT_PUBLIC_API_ORIGIN=https://pmp.calecutech.com

# Google sign-in (Supabase Auth). Public values, safe in the client bundle.
NEXT_PUBLIC_SUPABASE_URL=https://vspbbwpehvenmxddgbhm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_8yQLCPZV55NwBKI5ybeRAg__UggFFK_
