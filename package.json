{
  "name": "calecute",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build": "npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=apps/api",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "geo:fetch": "npm run geo:fetch --workspace=apps/api",
    "openapi": "npm run openapi --workspace=apps/api",
    "api:types": "npm run api:types --workspace=apps/web",
    "dev:recallio": "npm run dev --workspace=apps/recallio",
    "build:recallio": "npm run build --workspace=apps/recallio"
  },
  "devDependencies": {
    "xlsx": "^0.18.5"
  }
}
